# backlog-delivery adopter configuration — dispatch-board
# Format: TOML. Modelled on the plugin's backlog-delivery.config.example and on
# C:/Users/jdk/platform-catalogue/backlog-delivery.config; trimmed to the keys this repo resolves.
# Written by the planner (pbi-plan) on 2026-09-11 so the plan front can resolve its paths.
# Enforced hooks are NOT installed: that is bd-adopt's job and needs the owner's go-ahead.

board_path      = "docs/backlog/BOARD.md"
pbi_dir         = "docs/backlog/pbi"
specs_dir       = "docs/backlog/specs"
research_dir    = "docs/backlog/research"
done_log_path   = "docs/backlog/done-log.md"
handover_dir    = "docs/backlog/handovers"
handover_rotation_days = 30
ledger_stale_days = 7
reviews_dir     = "docs/backlog/reviews"
ledger_path     = "docs/backlog/ledger.md"
adr_dir         = "docs/adr"
worktree_script = "scripts/create-pbi-worktree.py"

[ci]

[backlog_provider]
provider = "local"

[test_commands]
# Two suites, both stdlib-only: the exporters (unittest) and the page's state test (node).
backend  = "python -m unittest discover -s tests"
frontend = "node tests/page.test.mjs"

[commit_policy]
attribution = true

# Shared-surface cohorts. A PBI's conflict_group MUST be one of these names
# (SPEC §PBI metadata); the planner may not coin new ones.
[conflict_groups]
exporters = "exporters/**, tests/test_*.py — session and board exporters, the refresh planner, and their unittest suite"
page      = "site/**, tests/page.test.mjs — the dashboard page and its state test"
local-app = "local/** — the next iteration's collector, local database, local server, record shapes and deployment files"
config    = "board.config.json, projects/** — the project list and hand-kept build state"
docs      = "docs/**, CLAUDE.md, README.md — brief, PRD, specs, ADRs, backlog artifacts and repo docs"

[autonomy]
spec_review_max_rounds   = 3
spec_review_max_minutes  = 20
code_review_max_rounds   = 2
# Plugin defaults: the plan gate waits for the owner.
autonomy_ceiling         = "assisted"
max_build_iterations     = 0
max_build_minutes        = 0
max_build_tokens         = 0
veto_marker_dir          = "docs/backlog/veto"
trust_store_path         = "docs/backlog/trust-store.json"
earned_lift_threshold    = 5
revert_window_days       = 7
trust_provisional_ttl_days = 30

[autonomy.class_baseline]
trivial  = "autonomous"
standard = "supervised"
epic     = "assisted"

[reviewer]
mode = "same-vendor-subagent"
plan_gate_requires_human = true

[pr_steward]
enabled = false

[hooks]
# Enforced hooks are opt-in via bd-adopt; not installed.
enabled = false

[closeout]
[board]

[risk]
security_paths = []
blast_radius_max_files = 0
blast_radius_max_lines = 0
protected_branches = ["main"]
secret_scan_extra_patterns = []
